{
  "name": "dsh-phone-agent",
  "version": "0.2.0",
  "description": "Drive a paired Android phone from DSH: read its screen, tap, swipe, type, launch apps. Wraps the phone's accessibility service as agent tools.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "android",
    "accessibility",
    "phone",
    "automation",
    "agent",
    "ui-automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arhsl/dsh-phone-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Arhsl/dsh-phone-agent/issues"
  },
  "homepage": "https://github.com/Arhsl/dsh-phone-agent#readme",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/",
    "vendor/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/offline.test.js",
    "test:watch": "node --test test/offline.test.js",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "node scripts/prepack-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
